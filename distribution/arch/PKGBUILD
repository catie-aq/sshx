pkgname=sshx
pkgver=0.5.0
pkgrel=1
pkgdesc='A secure web-based, collaborative terminal'
url="https://vps.burro-piranha.ts.net:5176/"
license=(MIT)
arch=(x86_64)
depends=(glibc libgcc)
_disturl="https://vps.burro-piranha.ts.net:5176/dist"
_archive="$pkgname-$pkgver-linux-x86_64"
source=("$_archive.tar.gz::$_disturl/$_archive.tar.gz")
sha256sums=('SKIP')

package() {
    install -Dm0755 -t "$pkgdir/usr/bin/" "$pkgname"
}
