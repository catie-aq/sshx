# User/group IDs for Docker containers (avoids permission issues)
UID=1000
GID=1000

# sshx-server backend port (Rust server: gRPC + HTTP API)
SSHX_SERVER_PORT=8051

# Vite dev server port (SvelteKit frontend)
SSHX_WEB_PORT=5173

# Redis port (exposed on localhost)
SSHX_REDIS_PORT=12601

# TLS certificate paths (for HTTPS dev server)
TLS_CERT=homa-server2.burro-piranha.ts.net.crt
TLS_KEY=homa-server2.burro-piranha.ts.net.key

# Tailscale hostname (used for override-origin and --host)
SSHX_HOST=homa-server2.burro-piranha.ts.net

# Server secret for HMAC signing
SSHX_SECRET=dev-secret
